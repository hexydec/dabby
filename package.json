	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hexydec/dabby/issues"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:types": "tsd",
		"build": "tsc -p tsconfig.build.json && vite build",
		"build:types": "tsc -p tsconfig.build.json",
		"build:bundle": "vite build",
		"dev": "vite build --watch",
		"demo": "vite --config demo/vite.config.ts"
	},
	"browserslist": [
		"defaults"
	],
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"src/**/*.js",
		"src/**/*.ts"
	],
	"tsd": {
		"directory": "test-d",
		"compilerOptions": {
			"lib": [
				"ES2022",
				"DOM",
				"DOM.Iterable"
			],
			"paths": {
				"dabbyjs": [
					"./src/dabby.ts"
				],
				"dabbyjs/*": [
					"./src/*",
					"./dist/*"
				]
			}
		}
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"benchmark": "^2.1.4",
		"happy-dom": "^20.8.9",
		"jsdoc": "^4.0.4",
		"terser": "^5.43.1",
		"tsd": "^0.33.0",
		"typescript": "^5.9.2",
		"vite": "^7.3.3",
		"vitest": "^3.2.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexydec/dabby.git"
	}
}
